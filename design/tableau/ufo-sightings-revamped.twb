      <column caption="ufo_sightings.csv" datatype="table" name="[__tableau_internal_object_id__].[ufo_sightings.csv_CD5BD7D7CE9F4155A4F335DF14A09077]" role="measure" type="quantitative" />
      <column caption="City" datatype="string" name="[city]" role="dimension" semantic-role="[City].[Name]" type="nominal" />
      <column caption="Country" datatype="string" name="[country]" role="dimension" semantic-role="[Country].[ISO3166_2]" type="nominal" />
      <column caption="Date Posted" datatype="date" name="[date posted]" role="dimension" type="ordinal" />
      <column caption="Datetime" datatype="datetime" name="[datetime]" role="dimension" type="ordinal" />
      <column caption="Duration (Hours/Min)" datatype="string" name="[duration (hours/min)]" role="dimension" type="nominal" />
      <column caption="Duration (Seconds)" datatype="real" name="[duration (seconds)]" role="measure" type="quantitative" />
      <column aggregation="Avg" caption="Latitude" datatype="real" name="[latitude]" role="measure" semantic-role="[Geographical].[Latitude]" type="quantitative" />
      <column aggregation="Avg" caption="Longitude" datatype="real" name="[longitude]" role="measure" semantic-role="[Geographical].[Longitude]" type="quantitative" />
      <column caption="Shape" datatype="string" name="[shape]" role="dimension" type="nominal" />
      <column caption="State" datatype="string" name="[state]" role="dimension" semantic-role="[State].[Name]" type="nominal">
        <semantic-values semantic-role="[State].[Name]">
          <semantic-value key="&quot;az&quot;" value="&quot;Arizona&quot;" />
          <semantic-value key="&quot;ga&quot;" value="&quot;Georgia&quot;" />
          <semantic-value key="&quot;ny&quot;" value="&quot;New York&quot;" />
        </semantic-values>
      </column>
      <column name="[UFO Evening Share]" caption="Evening reports" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF DATEPART('hour', [datetime]) &gt;= 18 THEN 1 ELSE 0 END) / COUNT([datetime])" />
      </column>
      <column name="[UFO Shape Missing]" caption="Unknown or missing shape" datatype="integer" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="SUM(IF ISNULL([shape]) OR [shape] = 'unknown' THEN 1 ELSE 0 END)" />
      </column>
      <column name="[UFO Month Name]" caption="Month" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="DATENAME('month', [datetime])" />
      </column>
      <column name="[UFO Shape Label]" caption="Shape" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ISNULL([shape]) THEN 'Not recorded' ELSE UPPER(LEFT([shape], 1)) + MID([shape], 2) END" />
      </column>
      <column name="[UFO City Label]" caption="City, state" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="UPPER(LEFT([city], 1)) + MID([city], 2) + ', ' + UPPER([state])" />
      </column>
      <column name="[UFO Geography Scope]" caption="Contiguous United States" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[country] = 'us' AND [state] IN ('al', 'ar', 'az', 'ca', 'co', 'ct', 'de', 'fl', 'ga', 'ia', 'id', 'il', 'in', 'ks', 'ky', 'la', 'ma', 'md', 'me', 'mi', 'mn', 'mo', 'ms', 'mt', 'nc', 'nd', 'ne', 'nh', 'nj', 'nm', 'nv', 'ny', 'oh', 'ok', 'or', 'pa', 'ri', 'sc', 'sd', 'tn', 'tx', 'ut', 'va', 'vt', 'wa', 'wi', 'wv', 'wy')" />
      </column>
      <column name="[UFO Month Share]" caption="Share of reports" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="COUNT([datetime]) / WINDOW_SUM(COUNT([datetime]))" />
      </column>
      <column-instance column="[datetime]" derivation="Hour" name="[hr:datetime:ok]" pivot="key" type="ordinal" />
      <column-instance column="[datetime]" derivation="Month" name="[mn:datetime:ok]" pivot="key" type="ordinal" />
      <column-instance column="[city]" derivation="None" name="[none:city:nk]" pivot="key" type="nominal" />
      <column-instance column="[country]" derivation="None" name="[none:country:nk]" pivot="key" type="nominal" />
      <column-instance column="[shape]" derivation="None" name="[none:shape:nk]" pivot="key" type="nominal" />
      <column-instance column="[state]" derivation="None" name="[none:state:nk]" pivot="key" type="nominal" />
      <group caption="Action (UFO Count by Shape)" name="[Action (UFO Count by Shape)]" hidden="true" name-style="unqualified" user:auto-column="sheet_link">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[UFO Shape Label]" />
        </groupfilter>
      </group>
      <group caption="Action (UFO Count by State)" name="[Action (UFO Count by State)]" hidden="true" name-style="unqualified" user:auto-column="sheet_link">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[state]" />
        </groupfilter>
      </group>
      <group caption="Action (UFO Count by State Map)" name="[Action (UFO Count by State Map)]" hidden="true" name-style="unqualified" user:auto-column="sheet_link">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[country]" />
          <groupfilter function="level-members" level="[state]" />
        </groupfilter>
      </group>
      <group caption="Action (Country,State)" hidden="true" name="[Action (Country,State)]" name-style="unqualified" user:auto-column="sheet_link">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[country]" />
          <groupfilter function="level-members" level="[state]" />
        </groupfilter>
      </group>
      <group caption="Action (MONTH(Datetime),HOUR(Datetime))" hidden="true" name="[Action (MONTH(Datetime),HOUR(Datetime))]" name-style="unqualified" user:auto-column="sheet_link">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[mn:datetime:ok]" />
          <groupfilter function="level-members" level="[hr:datetime:ok]" />
        </groupfilter>
      </group>
      <group hidden="true" name="[Exclusions (City,Country,State)]" name-style="unqualified" user:auto-column="exclude">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[none:city:nk]" />
          <groupfilter function="level-members" level="[none:country:nk]" />
          <groupfilter function="level-members" level="[none:state:nk]" />
        </groupfilter>
      </group>
