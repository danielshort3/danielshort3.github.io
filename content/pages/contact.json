{
  "id": "contact",
  "template": "visual-page",
  "outputPath": "pages/contact.html",
  "title": "Contact | Daniel Short",
  "canonicalPath": "/contact",
  "description": "Send Daniel Short a note about projects, tools, ideas, or questions.",
  "ogTitle": "Contact | Daniel Short",
  "ogDescription": "Send Daniel Short a note about projects, tools, ideas, or questions.",
  "siteName": "Daniel Short",
  "ogType": "website",
  "bodyAttributes": {
    "data-page": "contact",
    "class": "contact-page site-page"
  },
  "stylesheets": [
    "dist/styles.css",
    "css/components/destination-analytics.css",
    "css/components/contact-card.css"
  ],
  "headScripts": [
    {
      "src": "dist/site-shell.js",
      "defer": true
    },
    {
      "src": "js/common/no-js.js"
    }
  ],
  "bottomScripts": [
    {
      "src": "dist/site-contact.js",
      "defer": true
    },
    {
      "src": "dist/site-consent.js",
      "defer": true
    }
  ],
  "mainAttributes": {
    "id": "main"
  },
  "sections": [
    {
      "id": "contact-1",
      "type": "legacy-html",
      "label": "Let's Connect",
      "enabled": true,
      "variant": "default",
      "props": {
        "html": "<section class=\"hero hero--default alt-band\" data-page-masthead>\n    <div class=\"wrapper\">\n      <a href=\"/#contact\" aria-label=\"Back to categories\" data-page-masthead-parent><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M19 12H5m7 7-7-7 7-7\"></path></svg><span>Back to categories</span></a>\n      <div data-page-masthead-intro>\n        <div data-page-masthead-copy>\n          <h1>Let's Connect</h1>\n          <p class=\"hero-tagline\">Send a note about a project, tool, idea, or question. I’ll reply when I can.</p>\n        </div>\n        <div class=\"cta-group\" data-page-masthead-actions>\n          <button id=\"contact-form-toggle\" class=\"btn-primary hero-cta\">Send a Message</button>\n        </div>\n      </div>\n    </div>\n  </section>"
      }
    },
    {
      "id": "contact-2",
      "type": "legacy-html",
      "label": "Send a Message",
      "enabled": true,
      "variant": "default",
      "props": {
        "html": "<div id=\"contact-modal\" class=\"modal\">\n    <div class=\"modal-content\" role=\"dialog\" aria-modal=\"true\" tabindex=\"0\" aria-labelledby=\"contact-modal-title\">\n      <button class=\"modal-close\" aria-label=\"Close dialog\">&times;</button>\n      <div class=\"modal-title-strip\"><h3 class=\"modal-title\" id=\"contact-modal-title\">Send a Message</h3></div>\n      <div class=\"modal-body\">\n        <form id=\"contact-form\" class=\"contact-form\" method=\"post\" action=\"/api/contact\" data-endpoint=\"/api/contact\" novalidate>\n          <div class=\"form-field\">\n            <label for=\"contact-name\">Name <span class=\"field-required\" id=\"contact-name-required\" hidden>- Required</span></label>\n            <input id=\"contact-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required maxlength=\"200\" placeholder=\"Jane Doe\" aria-describedby=\"contact-name-required\">\n          </div>\n          <div class=\"form-field\">\n            <label for=\"contact-email\">Email <span class=\"field-required\" id=\"contact-email-required\" hidden>- Required</span></label>\n            <input id=\"contact-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required placeholder=\"you@example.com\" aria-describedby=\"contact-email-required\">\n          </div>\n          <div class=\"form-field\">\n            <label for=\"contact-message\">How can I help? <span class=\"field-required\" id=\"contact-message-required\" hidden>- Required</span></label>\n            <textarea id=\"contact-message\" name=\"message\" rows=\"5\" maxlength=\"4000\" required placeholder=\"Share a few details about your project, idea, or question.\" aria-describedby=\"contact-message-required\"></textarea>\n          </div>\n          <div class=\"form-field honeypot\" aria-hidden=\"true\">\n            <label for=\"contact-company\">Company</label>\n            <input id=\"contact-company\" name=\"company\" type=\"text\" tabindex=\"-1\" autocomplete=\"off\">\n          </div>\n          <p id=\"contact-status\" class=\"contact-form-status\" role=\"status\" aria-live=\"polite\" tabindex=\"-1\"></p>\n          <div id=\"contact-alt\" class=\"contact-form-alt\" hidden>\n            <a href=\"mailto:daniel@danielshort.me\" class=\"btn-ghost\">Email me directly</a>\n          </div>\n          <div class=\"form-actions\">\n            <button type=\"submit\" class=\"btn-primary\">\n              <span class=\"btn-spinner\" aria-hidden=\"true\"></span>\n              <span class=\"btn-label\">Send Message</span>\n            </button>\n          </div>\n        </form>\n        <div class=\"contact-form-success\" id=\"contact-success\" hidden tabindex=\"-1\" role=\"status\" aria-live=\"polite\">\n          <span class=\"success-icon\" aria-hidden=\"true\"></span>\n          <h4>Message sent</h4>\n          <p>Thanks for reaching out. I received your note and will reply shortly. If it’s urgent, feel free to send a direct email as well.</p>\n          <div class=\"form-actions\">\n            <button type=\"button\" class=\"btn-primary\" data-contact-new>Start another message</button>\n            <a href=\"mailto:daniel@danielshort.me\" class=\"btn-secondary\">Email me directly</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>"
      }
    },
    {
      "id": "contact-3",
      "type": "legacy-html",
      "label": "Contact Options",
      "enabled": true,
      "variant": "default",
      "props": {
        "html": "<section id=\"contact-options\" class=\"surface-band reveal\">\n    <div class=\"wrapper\">\n      <div class=\"contact-options-heading\">\n        <h2 class=\"section-title\">Other ways to connect</h2>\n        <p class=\"section-subtitle\">Email is fastest. I’m based in Delta, Colorado.</p>\n      </div>\n      <div class=\"contact-grid contact-big\">\n        <a href=\"mailto:daniel@danielshort.me\" class=\"contact-card\">\n          <span class=\"contact-card__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"36\" height=\"36\"><rect x=\"2.5\" y=\"5\" width=\"19\" height=\"14\" rx=\"2\"></rect><path d=\"m3.5 7 8.5 6 8.5-6\"></path></svg></span>\n          <span class=\"contact-card__copy\"><strong>Email</strong><small>daniel@danielshort.me</small></span>\n          <span class=\"contact-card__arrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path d=\"m9 5 7 7-7 7\"></path></svg></span>\n        </a>\n        <a href=\"https://github.com/danielshort3\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"contact-card\">\n          <span class=\"contact-card__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"36\" height=\"36\"><circle cx=\"6\" cy=\"5\" r=\"2\"></circle><circle cx=\"18\" cy=\"5\" r=\"2\"></circle><circle cx=\"12\" cy=\"19\" r=\"2\"></circle><path d=\"M6 7v3c0 2 1.6 3 3.5 3H12M18 7v3c0 2-1.6 3-3.5 3H12M12 13v4\"></path></svg></span>\n          <span class=\"contact-card__copy\"><strong>GitHub</strong><small>github.com/danielshort3</small></span>\n          <span class=\"contact-card__arrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path d=\"M14 4h6v6M20 4 10 14M10 4H4v16h16v-6\"></path></svg></span>\n        </a>\n      </div>\n    </div>\n  </section>"
      }
    },
    {
      "id": "grand-junction-location",
      "type": "map",
      "label": "Delta Location",
      "enabled": true,
      "variant": "default",
      "props": {
        "title": "Delta, Colorado",
        "body": "My home base in western Colorado.",
        "address": "Delta, CO",
        "showLink": false,
        "embed": true,
        "useEmbedApi": false,
        "persist": true,
        "zoom": 10
      }
    }
  ]
}
