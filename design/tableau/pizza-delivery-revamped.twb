            </column>
            <column name="[Calculation_Pizza_Pizza_deliveries_label]" caption="Pizza deliveries label" datatype="string" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(COUNT([Tip])) + IF COUNT([Tip]) &lt; 30 THEN '*' ELSE '' END" />
            </column>
            <column name="[Calculation_Pizza_Pizza_sample_size]" caption="Pizza sample size" datatype="string" role="measure" type="nominal">
              <calculation class="tableau" formula="IF COUNT([Tip]) &lt; 30 THEN 'Fewer than 30' ELSE '30 or more' END" />
            </column>
            <column name="[Calculation_Pizza_Pizza_selected_median]" caption="Pizza selected median" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="{ EXCLUDE [Tip (bin)] : MEDIAN([Tip]) }" />
            </column>
            <column aggregate-role-from="[zip]" datatype="string" name="[City]" role="dimension" semantic-role="[City].[Name]" type="nominal" />
            <column datatype="date" name="[Date]" role="dimension" type="ordinal" />
            <column aggregation="None" datatype="integer" name="[Delivery_Length (bin)]" role="dimension" type="quantitative">
              <calculation class="bin" decimals="1" formula="[Calculation_1753589172811726849]" peg="0" size="10" />
            </column>
            <column datatype="string" name="[Housing]" role="dimension" type="nominal" />
            <column aggregation="None" datatype="integer" name="[Tip (bin)]" role="dimension" type="quantitative">
              <calculation class="bin" decimals="0" formula="[Tip]" peg="0" size="2" />
            </column>
            <column datatype="real" name="[Tip]" role="measure" type="quantitative" />
            <column aggregation="Sum" caption="Total Delivery Time - Split 1" datatype="real" hidden="true" name="[Total Delivery Time - Split 1]" role="dimension" type="ordinal" user:SplitFieldIndex="1" user:SplitFieldOrigin="[federated.1enxy2v12gw5w218gu8fm1cgua6k].[Total Delivery Time]">
              <calculation class="tableau" formula="FLOAT( SPLIT( [Total Delivery Time], &quot;:&quot;, 1 ) )" />
            </column>
            <column aggregation="Sum" caption="Total Delivery Time - Split 2" datatype="integer" hidden="true" name="[Total Delivery Time - Split 2]" role="dimension" type="ordinal" user:SplitFieldIndex="2" user:SplitFieldOrigin="[federated.1enxy2v12gw5w218gu8fm1cgua6k].[Total Delivery Time]">
