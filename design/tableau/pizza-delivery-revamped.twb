      <aliases enabled="yes" />
      <column name="[Calculation_Pizza_Pizza_selected_median]" caption="Pizza selected median" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ EXCLUDE [Tip (bin)] : MEDIAN([Tip]) }" />
      </column>
      <column name="[Calculation_Pizza_Pizza_deliveries_label]" caption="Pizza deliveries label" datatype="string" role="measure" type="nominal">
        <calculation class="tableau" formula="STR(COUNT([Tip])) + IF COUNT([Tip]) &lt; 30 THEN '*' ELSE '' END" />
      </column>
      <column name="[Calculation_Pizza_Pizza_sample_size]" caption="Pizza sample size" datatype="string" role="measure" type="nominal">
        <calculation class="tableau" formula="IF COUNT([Tip]) &lt; 30 THEN 'Fewer than 30' ELSE '30 or more' END" />
      </column>
      <column caption="Awnd" datatype="real" name="[AWND]" role="measure" type="quantitative" />
      <column caption="Delivery_Length" datatype="integer" datatype-customized="true" name="[Calculation_1753589172811726849]" role="measure" type="quantitative">
        <calculation class="tableau" formula="INT([Total Delivery Time - Split 1] * 60 + [Total Delivery Time - Split 2])" />
      </column>
      <column caption="Ordered" datatype="datetime" name="[Calculation_1753589172812005378]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="MAKEDATETIME([Date],[Order Time])" />
      </column>
      <column caption="Delivered" datatype="datetime" name="[Calculation_1753589172812075011]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="MAKEDATETIME([Date],[Delivery Time])" />
      </column>
