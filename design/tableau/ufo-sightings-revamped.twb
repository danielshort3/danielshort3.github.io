              </calculation>
            </column>
            <column name="[UFO Geography Scope]" caption="Contiguous United States" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[country] = 'us' AND [state] IN ('al', 'ar', 'az', 'ca', 'co', 'ct', 'de', 'fl', 'ga', 'ia', 'id', 'il', 'in', 'ks', 'ky', 'la', 'ma', 'md', 'me', 'mi', 'mn', 'mo', 'ms', 'mt', 'nc', 'nd', 'ne', 'nh', 'nj', 'nm', 'nv', 'ny', 'oh', 'ok', 'or', 'pa', 'ri', 'sc', 'sd', 'tn', 'tx', 'ut', 'va', 'vt', 'wa', 'wi', 'wv', 'wy')" />
            </column>
            <column name="[UFO Shape Label]" caption="Shape" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF ISNULL([shape]) THEN 'Not recorded' ELSE UPPER(LEFT([shape], 1)) + MID([shape], 2) END" />
            </column>
            <column name="[UFO City Label]" caption="City, state" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="UPPER(LEFT([city], 1)) + MID([city], 2) + ', ' + UPPER([state])" />
